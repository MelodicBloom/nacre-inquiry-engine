{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deterministic Inquiry Engine",
  "description": "A structured question system that discovers properties and positions on semantic axes through metaphor, backwards discovery, Socratic thinking, and creative imagination. Outputs machine-readable profiles.",
  "type": "object",
  "required": ["schema_name", "version", "entity", "layers"],
  "properties": {
    "schema_name": { "type": "string", "const": "DeterministicInquiryEngine" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "entity": {
      "type": "object",
      "required": ["id", "name", "entity_type"],
      "properties": {
        "id": { "type": "string", "description": "Unique slug identifier" },
        "name": { "type": "string", "minLength": 1 },
        "entity_type": {
          "type": "string",
          "enum": ["system","scene","component","material","brand","interaction","artifact","experience","concept"]
        },
        "scope": {
          "type": "string",
          "enum": ["concept","prototype","production","speculative"]
        },
        "description": { "type": "string" }
      }
    },
    "layers": {
      "type": "object",
      "required": ["essence","semantic_axes","negative_definition","behavior","symbolism","composition","relationships","implementation_translation"],
      "properties": {
        "essence": {
          "type": "object",
          "required": ["core_metaphor","governing_verb","one_sentence_thesis"],
          "properties": {
            "core_metaphor": { "type": "string", "description": "A vivid image or place the thing resembles" },
            "governing_noun": { "type": "string", "description": "The irreducible substance" },
            "governing_verb": { "type": "string", "description": "What it is always doing" },
            "felt_center": { "type": "string", "description": "The emotional atmosphere at its core" },
            "one_sentence_thesis": { "type": "string", "description": "A single sentence stating what the thing is trying to become" }
          }
        },
        "semantic_axes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["axis_id","left_pole","right_pole","position","confidence"],
            "properties": {
              "axis_id": { "type": "string" },
              "left_pole": { "type": "string" },
              "right_pole": { "type": "string" },
              "position": { "type": "number", "minimum": 0.0, "maximum": 1.0, "description": "0 = left pole, 1 = right pole, 0.5 = neutral" },
              "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "evidence": { "type": "array", "items": { "type": "string" } },
              "notes": { "type": "string" }
            }
          }
        },
        "negative_definition": {
          "type": "object",
          "properties": {
            "is_not": { "type": "array", "items": { "type": "string" } },
            "rejects": { "type": "array", "items": { "type": "string" } },
            "anti_examples": { "type": "array", "items": { "type": "string" } },
            "failure_modes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "behavior": {
          "type": "object",
          "properties": {
            "idle_state": { "type": "string" },
            "responsive_state": { "type": "string" },
            "stress_state": { "type": "string" },
            "recovery_state": { "type": "string" },
            "adaptation_style": {
              "type": "string",
              "enum": ["rebound","dissolve","harden","bloom","ripple","fracture","adapt","freeze","yield","expand"]
            }
          }
        },
        "symbolism": {
          "type": "object",
          "properties": {
            "archetype": { "type": "string" },
            "lore_role": { "type": "string" },
            "material_associations": { "type": "array", "items": { "type": "string" } },
            "symbolic_pairs": { "type": "array", "items": { "type": "string" } },
            "cultural_resonances": { "type": "array", "items": { "type": "string" } }
          }
        },
        "composition": {
          "type": "object",
          "properties": {
            "symmetry_type": { "type": "string", "enum": ["radial","bilateral","asymmetric","modular","fractal","layered"] },
            "dominant_structure": { "type": "string" },
            "contrast_style": { "type": "string", "enum": ["scale","texture","light","density","temperature","silence","motion","color"] },
            "rhythm_type": { "type": "string", "enum": ["pulse","wave","lattice","path","bloom","stutter","drift","cascade"] },
            "hierarchy_logic": { "type": "string" }
          }
        },
        "relationships": {
          "type": "object",
          "properties": {
            "allies": { "type": "array", "items": { "type": "string" } },
            "opposites": { "type": "array", "items": { "type": "string" } },
            "dependencies": { "type": "array", "items": { "type": "string" } },
            "bridges": { "type": "array", "items": { "type": "string" } },
            "container_system": { "type": "string" }
          }
        },
        "implementation_translation": {
          "type": "object",
          "properties": {
            "token_domains": { "type": "array", "items": { "type": "string" } },
            "component_implications": { "type": "array", "items": { "type": "string" } },
            "interaction_rules": { "type": "array", "items": { "type": "string" } },
            "rendering_constraints": { "type": "array", "items": { "type": "string" } },
            "documentation_required": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "author": { "type": "string" },
        "session_id": { "type": "string" },
        "inquiry_version": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
